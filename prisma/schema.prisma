generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ──────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  image         String?
  gstNumber     String?
  companyName   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  quotes    QuoteRequest[]
  orders    Order[]
  reviews   Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String  @default("India")
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]
}

// ─── QUOTE SYSTEM ──────────────────────────────────────────────────────────

enum QuoteStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  PAYMENT_PENDING
  IN_PRODUCTION
  QUALITY_CHECK
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
}

model QuoteRequest {
  id          String      @id @default(cuid())
  userId      String?
  guestEmail  String?
  guestPhone  String?
  guestName   String?
  status      QuoteStatus @default(DRAFT)
  referenceNo String      @unique

  fileName  String
  fileKey   String
  fileUrl   String
  fileSize  Int
  fileType  String

  dimensionX  Float?
  dimensionY  Float?
  dimensionZ  Float?
  volumeCm3   Float?
  surfaceArea Float?

  material      String
  color         String
  layerHeight   Float
  infill        Int
  finish        String
  quantity      Int    @default(1)
  deliverySpeed String
  notes         String? @db.Text

  estimatedPrice Float?
  finalPrice     Float?
  currency       String @default("INR")

  adminNotes String? @db.Text
  printTime  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?            @relation(fields: [userId], references: [id])
  order      Order?
  statusLogs QuoteStatusLog[]
}

model QuoteStatusLog {
  id          String       @id @default(cuid())
  quoteId     String
  fromStatus  QuoteStatus?
  toStatus    QuoteStatus
  note        String?
  changedById String?
  createdAt   DateTime     @default(now())

  quote QuoteRequest @relation(fields: [quoteId], references: [id])
}

// ─── E-COMMERCE ────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String   @db.Text
  shortDesc    String?
  categoryId   String
  basePrice    Float
  comparePrice Float?
  sku          String   @unique
  stock        Int      @default(100)
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  metaTitle    String?
  metaDesc     String?
  tags         String[]
  printTime    String?
  material     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
  reviews    Review[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id])
}

model ProductVariant {
  id         String @id @default(cuid())
  productId  String
  name       String
  sku        String @unique
  price      Float
  stock      Int    @default(100)
  attributes Json

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]
}

// ─── ORDERS ────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  IN_PRODUCTION
  QUALITY_CHECK
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderType {
  PRODUCT
  QUOTE
}

model Order {
  id        String      @id @default(cuid())
  orderNo   String      @unique
  userId    String
  addressId String?
  quoteId   String?     @unique
  type      OrderType
  status    OrderStatus @default(PENDING)

  subtotal       Float
  shippingCost   Float  @default(0)
  taxRate        Float  @default(18)
  taxAmount      Float
  discountAmount Float  @default(0)
  total          Float
  currency       String @default("INR")
  notes          String?

  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id])
  address    Address?         @relation(fields: [addressId], references: [id])
  quote      QuoteRequest?    @relation(fields: [quoteId], references: [id])
  items      OrderItem[]
  payment    Payment?
  invoice    Invoice?
  statusLogs OrderStatusLog[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  name      String
  sku       String
  quantity  Int
  unitPrice Float
  total     Float

  order   Order           @relation(fields: [orderId], references: [id])
  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

// ─── PAYMENTS ──────────────────────────────────────────────────────────────

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String          @unique
  provider          PaymentProvider
  providerOrderId   String?
  providerPaymentId String?
  paymentLinkId     String?
  paymentLinkUrl    String?
  status            PaymentStatus   @default(CREATED)
  amount            Float
  currency          String          @default("INR")
  signature         String?
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

// ─── INVOICES ──────────────────────────────────────────────────────────────

model Invoice {
  id        String    @id @default(cuid())
  orderId   String    @unique
  invoiceNo String    @unique
  issuedAt  DateTime  @default(now())
  dueDate   DateTime?
  pdfKey    String?
  pdfUrl    String?
  gstNumber String?

  order Order @relation(fields: [orderId], references: [id])
}

// ─── REVIEWS ───────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  body      String?  @db.Text
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// ─── LEAD GENERATION ───────────────────────────────────────────────────────

model LeadContact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String
  message   String?  @db.Text
  source    String
  createdAt DateTime @default(now())
  handled   Boolean  @default(false)
}

// ─── BLOG ──────────────────────────────────────────────────────────────────

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  body        String    @db.Text
  coverImage  String?
  authorId    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  metaTitle   String?
  metaDesc    String?
  tags        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
